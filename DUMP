        getconstants     = type(getconstants) == "function",
        getscriptbytecode= type(getscriptbytecode) == "function",
        getupvalues      = type(getupvalues) == "function",
        decompile        = type(decompile) == "function",
        debug_getconstants = debug and type(debug.getconstants) == "function",
        debug_getinfo    = debug and type(debug.getinfo) == "function",
        writefile        = type(writefile) == "function",
        isfolder         = type(isfolder) == "function",
        makefolder       = type(makefolder) == "function",
        identifyexecutor = type(identifyexecutor) == "function",
    }
end

local caps = Stealth.detect()

-- ─── Wrap ───
function Stealth.wrap(fn)
    if not caps.newcclosure then return fn end
    local ok, wrapped = pcall(newcclosure, fn)
    if ok and wrapped then return wrapped end
    return fn
end

-- ─── Safe call ───
function Stealth.safeCall(name, fn, ...)
    if not Stealth.Originals[name] then
        Stealth.Originals[name] = fn
    end
    local target = Stealth.Originals[name]
    local wrapped = Stealth.wrap(target)
    local ok, r = pcall(wrapped, ...)
    if not ok then
        if not Config.Stealth.SuppressErrors then
            Utils.warn("[Stealth] " .. name .. " err: " .. tostring(r))
        end
        return nil
    end
    return r
end

-- ─── Quiet (silent) ───
function Stealth.quiet(fn, ...)
    local ok, r = pcall(fn, ...)
    if not ok then return nil end
    return r
end

-- ─── Delay ───
function Stealth.delay(base)
    if not Config.Stealth.RandomizeDelay then
        task.wait(base or 0); return
    end
    local jitter = Config.Stealth.DelayMin
        + math.random() * (Config.Stealth.DelayMax - Config.Stealth.DelayMin)
    task.wait((base or 0) + jitter)
end

-- ─── Random name ───
function Stealth.randomName(prefix)
    prefix = prefix or "X"
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local len = 8 + math.random(0, 6)
    local out = {}
    for _ = 1, len do
        local i = math.random(1, #chars)
        table.insert(out, chars:sub(i, i))
    end
    return prefix .. "_" .. table.concat(out)
end

-- ─── Safe GUI parenting ───
function Stealth.parentGui(gui)
    if not Config.Stealth.HideFromPlayerGui then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        return
    end

    -- ลอง gethui ก่อน
    if caps.gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then
            local parented = pcall(function() gui.Parent = hui end)
            if parented then return end
        end
    end

    -- ลอง CoreGui
    local ok = pcall(function() gui.Parent = CoreGui end)
    if ok then return end

    -- สุดท้าย PlayerGui + random name
    if Config.Stealth.RandomizeNames then
        gui.Name = Stealth.randomName("Svc")
    end
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- ─── Hook detection ───
function Stealth.detectHooks()
    local threats = {}
    if not Config.Stealth.DetectHooks then return threats end
    if not caps.getrawmetatable then return threats end

    -- เช็ค game metatable
    local ok, mt = pcall(getrawmetatable, game)
    if ok and mt and mt.__namecall then
        local isNative = false
        pcall(function()
            if caps.debug_getinfo then
                local info = debug.getinfo(mt.__namecall)
                if info and info.source == "=[C]" then isNative = true end
            end
        end)
        if not isNative then
            table.insert(threats, "game.__namecall (ไม่ใช่ native)")
        end
    end

    -- เช็คฟังก์ชันสำคัญ
    local apis = {
        "getscripts","getconstants","decompile","warn","print",
        "getscriptbytecode","getupvalues",
    }
    for _, name in ipairs(apis) do
        local fn = rawget(getfenv and getfenv() or _G, name)
            or rawget(_G, name)
        if type(fn) == "function" and caps.debug_getinfo then
            local info = Stealth.quiet(debug.getinfo, fn)
            if info and info.source and info.source ~= "=[C]" then
                table.insert(threats,
                    name .. " ถูก wrap: " .. tostring(info.source))
            end
        end
    end

    Stealth.Threats = threats
    return threats
end

-- ─── Caller spoof wrapper ───
function Stealth.spoofCaller(fn)
    if not Config.Stealth.SpoofCaller then return fn end
    if not caps.newcclosure then return fn end
    return Stealth.wrap(function(...)
        if type(setthreadidentity) == "function" then
            pcall(setthreadidentity, 2)
        end
        local r = fn(...)
        if type(setthreadidentity) == "function" then
            pcall(setthreadidentity, 8)
        end
        return r
    end)
end

-- ─── Stealth init ───
function Stealth.init()
    if not Config.Stealth.Enabled then
        Utils.log("Stealth: ปิด (ใช้โหมดปกติ)")
        return
    end
    Utils.log("🛡️ เริ่มระบบ Stealth...")

    -- โหลด original APIs
    for _, name in ipairs({
        "getscripts","getconstants","getscriptbytecode",
        "getupvalues","decompile","warn","print",
    }) do
        local fn = rawget(getfenv and getfenv() or _G, name)
            or rawget(_G, name)
        if type(fn) == "function" then
            Stealth.Originals[name] = fn
        end
    end

    -- ตรวจ hook
    local threats = Stealth.detectHooks()
    if #threats > 0 then
        Utils.warn("ตรวจพบ hook " .. #threats .. " จุด:")
        for _, t in ipairs(threats) do
            Utils.warn("  • " .. t)
        end
    else
        Utils.ok("ไม่พบ hook ที่น่าสงสัย")
    end

    -- หน่วงเริ่มต้น
    if Config.Stealth.RandomStartDelay then
        local d = 0.3 + math.random() * 0.7
        Utils.log(string.format("รอเริ่ม %.2f วิ...", d))
        task.wait(d)
    end
end

