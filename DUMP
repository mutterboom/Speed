local Filter = {}
Filter.__index = Filter

function Filter.new(cfg)
    local self = setmetatable({}, Filter)
    self.cfg = cfg
    return self
end

function Filter:shouldKeep(obj)
    local cfg = self.cfg
    if cfg.OnlyBaseParts and not obj:IsA("BasePart") then return false end
    if cfg.OnlyScripts and not obj:IsA("LuaSourceContainer") then return false end
    if cfg.OnlyModels and not obj:IsA("Model") then return false end

    for _, cls in ipairs(cfg.IgnoreClasses or {}) do
        if obj:IsA(cls) then return false end
    end

    if #(cfg.OnlyNameMatch or {}) > 0 then
        local found = false
        for _, n in ipairs(cfg.OnlyNameMatch) do
            if obj.Name == n then found = true break end
        end
        if not found then return false end
    end

    if obj:IsA("BasePart") then
        if cfg.IgnoreInvisible and obj.Transparency >= 1 then return false end
        if cfg.IgnoreUnanchored and not obj.Anchored then return false end
        if cfg.MinSize > 0 then
            local s = obj.Size
            if s.X < cfg.MinSize and s.Y < cfg.MinSize and s.Z < cfg.MinSize then
                return false
            end
        end
    end
    return true
end

