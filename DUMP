local Sniffer = {
    Log = {},
    Running = false,
    Hooked = false,
}

function Sniffer.start()
    if Sniffer.Hooked then return end
    if not caps.getrawmetatable or not caps.setreadonly then
        Utils.warn("Sniffer: ไม่มี getrawmetatable")
        return
    end

    local mt = getrawmetatable(game)
    if not mt then return end

    local oldNamecall = mt.__namecall
    Sniffer.Originals = oldNamecall

    setreadonly(mt, false)
    mt.__namecall = Stealth.wrap(function(self, ...)
        local method = getnamecallmethod and getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer")
           and typeof(self) == "Instance"
           and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
            local args = {...}
            local info = {}
            for i, v in ipairs(args) do
                local vt = typeof(v)
                info[i] = {
                    type = vt,
                    value = vt == "Instance"
                        and Stealth.quiet(function() return v:GetFullName() end)
                        or Utils.truncate(tostring(v), 100),
                }
            end
            table.insert(Sniffer.Log, {
                Remote = Stealth.quiet(function() return self:GetFullName() end),
                Method = method,
                Args = info,
                Time = os.date("%H:%M:%S"),
                Tick = tick(),
            })
            if #Sniffer.Log > Config.Limits.SnifferMaxLog then
                table.remove(Sniffer.Log, 1)
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)

    Sniffer.Hooked = true
    Sniffer.Running = true
    Utils.ok("🎣 Remote Sniffer: เริ่มดักแล้ว")
end

function Sniffer.stop()
    Sniffer.Running = false
end

function Sniffer.getSummary()
    local summary = {}
    for _, log in ipairs(Sniffer.Log) do
        summary[log.Remote] = (summary[log.Remote] or 0) + 1
    end
    return summary
end

