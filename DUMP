function Extractor:getProperties(obj)
    local cfg = self.cfg
    local props = { ClassName = obj.ClassName, Name = obj.Name }

    if cfg.Options.StoreFullPath then
        if Config.Stealth.Enabled then
            props._path = Stealth.quiet(function() return obj:GetFullName() end) or "?"
        else
            props._path = Utils.safe(function() return obj:GetFullName() end) or "?"
        end
    end

    local attrs = Utils.getAttributes(obj)
    if next(attrs) then props._attributes = attrs end
    local tags = Utils.getTags(obj)
    if tags then props._tags = tags end

    if obj:IsA("BasePart") then
        props.Position = Utils.formatVector(obj.Position)
        props.PositionRaw = Utils.formatPosition(obj.Position)
        props.Size = Utils.formatVector(obj.Size)
        props.Orientation = Utils.formatVector(obj.Orientation)
        if cfg.Options.StoreCFrame then
            props.CFrame = Utils.formatCFrame(obj.CFrame)
        end
        props.Color = Utils.formatColor(obj.Color)
        props.Material = tostring(obj.Material)
        props.Transparency = obj.Transparency
        props.Reflectance = obj.Reflectance
        props.CanCollide = obj.CanCollide
        props.CanTouch = obj.CanTouch
        props.CanQuery = obj.CanQuery
        props.Anchored = obj.Anchored
        props.Massless = obj.Massless

        if obj:IsA("MeshPart") then
            props.MeshId = obj.MeshId
            props.TextureID = obj.TextureID
        end
        if obj:IsA("SpawnLocation") then
            props.Enabled = obj.Enabled
            props.TeamColor = Utils.formatColor(obj.TeamColor)
            props.Neutral = obj.Neutral
        end
    end

    if obj:IsA("Model") then
        props.PrimaryPart = obj.PrimaryPart and obj.PrimaryPart.Name or nil
        props.ChildCount = #obj:GetChildren()
    end

    if obj:IsA("LuaSourceContainer") then
        props.Source = "[Not Accessible]"
        if cfg.Options.StoreSource and Config.Stealth.Enabled then
            local src = Stealth.quiet(function() return obj.Source end)
            if src and #src > 0 then
                props.SourcePreview = Utils.truncate(src, cfg.Limits.MaxStringLen)
            end
        end
    end

    if obj:IsA("RemoteEvent") then props.RemoteType = "Event" end
    if obj:IsA("RemoteFunction") then props.RemoteType = "Function" end
    if obj:IsA("BindableEvent") then props.RemoteType = "Bindable" end

    if obj:IsA("ValueBase") then
        props.Value = tostring(obj.Value)
        props.ValueType = obj.ClassName
    end

    if obj:IsA("GuiObject") then
        props.Visible = obj.Visible
        props.GuiSize = tostring(obj.Size)
        props.GuiPosition = tostring(obj.Position)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            props.Text = Utils.truncate(obj.Text, 100)
            props.TextSize = obj.TextSize
        end
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            props.Image = obj.Image
        end
    end

    if obj:IsA("Decal") or obj:IsA("Texture") then
        props.Texture = obj.Texture
    end
    if obj:IsA("Sound") then
        props.SoundId = obj.SoundId
        props.Volume = obj.Volume
        props.Looped = obj.Looped
        props.Playing = obj.Playing
    end
    if obj:IsA("ParticleEmitter") then
        props.Enabled = obj.Enabled
        props.Rate = obj.Rate
    end
    if obj:IsA("Beam") then
        props.Enabled = obj.Enabled
        props.Width0 = obj.Width0
    end
    if obj:IsA("Trail") then props.Enabled = obj.Enabled end
    if obj:IsA("ProximityPrompt") then
        props.ActionText = obj.ActionText
        props.ObjectText = obj.ObjectText
        props.HoldDuration = obj.HoldDuration
        props.Enabled = obj.Enabled
    end
    if obj:IsA("ClickDetector") then
        props.MaxActivationDistance = obj.MaxActivationDistance
    end

    return props
end

function Extractor:dumpContainer(container)
    local cfg = self.cfg
    local result = {}
    local processed = 0

    local function recurse(obj, depth)
        if depth > cfg.Limits.MaxDepth then return end
        if self.count >= cfg.Limits.MaxObjects then return end

        local props = self:getProperties(obj)
        if self.filter:shouldKeep(obj) then
            props._depth = depth
            table.insert(result, props)
            self.count = self.count + 1
        end

        processed = processed + 1
        if Config.Stealth.Enabled
           and processed % Config.Stealth.ChunkSize == 0 then
            Stealth.delay(Config.Stealth.ChunkDelay)
        end

        for _, child in ipairs(obj:GetChildren()) do
            recurse(child, depth + 1)
        end
    end

    for _, child in ipairs(container:GetChildren()) do
        recurse(child, 1)
    end
    return result, self.count
end

function Extractor:buildTree(container, maxDepth)
    maxDepth = maxDepth or 4
    local function node(obj, depth)
        if depth > maxDepth then return nil end
        local entry = { Name = obj.Name, Class = obj.ClassName }
        local children = {}
        for _, c in ipairs(obj:GetChildren()) do
            local n = node(c, depth + 1)
            if n then table.insert(children, n) end
        end
        if #children > 0 then entry.Children = children end
        return entry
    end
    local root = {
        Name = container.Name or "Root",
        Class = container.ClassName or "Container",
    }
    local children = {}
    for _, c in ipairs(container:GetChildren()) do
        local n = node(c, 1)
        if n then table.insert(children, n) end
    end
    root.Children = children
    return root
end

