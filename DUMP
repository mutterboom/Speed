local Analyzer = {}

function Analyzer.analyze(dump, extra)
    extra = extra or {}
    local report = { Summary = {}, Hints = {}, Recommendations = {}, Risks = {} }

    report.Summary.Collectibles = #(dump.Collectibles or {})
    report.Summary.Enemies = #(dump.Enemies or {})
    report.Summary.Portals = #(dump.Portals or {})
    report.Summary.Remotes = #(dump.Remotes or {})
    report.Summary.Hitboxes = #(dump.Hitboxes or {})
    report.Summary.Spawns = #(dump.Spawns or {})

    local interested = 0
    for _, r in ipairs(dump.Remotes or {}) do
        if r.Interested then interested = interested + 1 end
    end
    report.Summary.InterestedRemotes = interested
    report.Summary.AntiCheat = #(dump.AntiCheatSuspects or {})
    report.Summary.SniffedRemotes = #(extra.SnifferLog or {})
    report.Summary.HitboxEvents = #(extra.HitboxEvents or {})

    if report.Summary.Collectibles > 0 then
        table.insert(report.Hints, "✅ Auto Collect: " .. report.Summary.Collectibles .. " จุด")
        table.insert(report.Recommendations, {
            Type = "AutoCollect", Feasible = true,
            Sample = dump.Collectibles[1],
        })
    else
        table.insert(report.Hints, "❌ Auto Collect: ไม่พบ (ปรับ pattern)")
    end

    if report.Summary.Enemies > 0 then
        table.insert(report.Hints, "✅ Auto Farm: " .. report.Summary.Enemies .. " targets")
        table.insert(report.Recommendations, {
            Type = "AutoFarm", Feasible = true,
            Sample = dump.Enemies[1],
        })
    end

    if report.Summary.Hitboxes > 0 then
        table.insert(report.Hints, "✅ Auto Parry: " .. report.Summary.Hitboxes .. " hitboxes")
        table.insert(report.Recommendations, {
            Type = "AutoParry", Feasible = true,
            Sample = dump.Hitboxes[1],
        })
    end

    if report.Summary.InterestedRemotes > 0 then
        table.insert(report.Hints, "✅ Remotes สนใจ: " .. report.Summary.InterestedRemotes .. " ตัว")
    end

    if report.Summary.Portals > 0 then
        table.insert(report.Hints, "✅ Portals: " .. report.Summary.Portals .. " จุด")
    end

    if report.Summary.SniffedRemotes > 0 then
        table.insert(report.Hints, "✅ Sniffer จับได้: " .. report.Summary.SniffedRemotes .. " events")
    end

    if report.Summary.AntiCheat > 0 then
        table.insert(report.Risks, "⚠️ Anti-Cheat: " .. report.Summary.AntiCheat .. " สัญญาณ")
        report.AntiCheatList = dump.AntiCheatSuspects
    else
        table.insert(report.Risks, "✅ ไม่พบ Anti-Cheat ชัดเจน")
    end

    return report
end

