local Serializer = {}
Serializer.__index = Serializer

function Serializer.new(config)
    local self = setmetatable({}, Serializer)
    self.cfg = config
    self.index = {}
    return self
end

function Serializer:encode(tbl)
    local json = Utils.safe(function()
        return HttpService:JSONEncode(tbl)
    end)
    if not json then
        Utils.warn("JSON encode failed")
        return nil
    end
    return json
end

function Serializer:save(name, tbl)
    local cfg = self.cfg
    local json = self:encode(tbl)
    if not json then return false end

    Utils.safe(function()
        if caps.isfolder and not isfolder(cfg.OutputFolder) then
            makefolder(cfg.OutputFolder)
        end
    end)

    local ts = Utils.makeTimestamp()
    local fileName = string.format("%s/%s_%s_%s.json",
        cfg.OutputFolder, name, tostring(game.PlaceId), ts)

    local ok, err = Utils.safe(writefile, fileName, json)
    if ok then
        local kb = math.floor(#json / 1024)
        Utils.ok(string.format("%-26s → %d KB", name, kb))
        table.insert(self.index, {
            name = name, file = fileName, size_kb = kb,
            count = type(tbl) == "table" and #tbl or 0,
        })
        Stealth.delay(0)
        return true
    else
        Utils.warn("writefile " .. name .. ": " .. tostring(err))
        return false
    end
end

function Serializer:saveIndex()
    local cfg = self.cfg
    local ts = Utils.makeTimestamp()
    local file = string.format("%s/_INDEX_%s_%s.json",
        cfg.OutputFolder, tostring(game.PlaceId), ts)
    local json = self:encode({
        Version = Config.Version,
        GeneratedAt = os.date("%Y-%m-%d %H:%M:%S"),
        PlaceId = game.PlaceId,
        JobId = game.JobId,
        Stealth = Config.Stealth.Enabled,
        Files = self.index,
    })
    if json then
        Utils.safe(writefile, file, json)
        Utils.ok("Index: " .. file)
    end
end

