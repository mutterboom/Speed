local HitboxTracker = {
    Events = {},
    Watching = {},
    Running = false,
}

function HitboxTracker:watch(names)
    for _, n in ipairs(names) do self.Watching[n] = true end
end

function HitboxTracker:start()
    if self.Running then return end
    self.Running = true

    task.spawn(function()
        while self.Running and scriptAlive do
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart")
                   and self.Watching[obj.Name]
                   and not obj:GetAttribute("_ht") then
                    obj:SetAttribute("_ht", true)
                    local spawn = tick()
                    table.insert(self.Events, {
                        Name = obj.Name,
                        SpawnTime = spawn,
                        Path = Stealth.quiet(function() return obj:GetFullName() end),
                    })
                    task.spawn(function()
                        local conn
                        conn = obj.AncestryChanged:Connect(function()
                            if conn then conn:Disconnect() end
                            for _, e in ipairs(self.Events) do
                                if e.SpawnTime == spawn and not e.DespawnTime then
                                    e.DespawnTime = tick()
                                    e.Duration = e.DespawnTime - e.SpawnTime
                                    break
                                end
                            end
                        end)
                    end)
                    if #self.Events > Config.Limits.HitboxMaxLog then
                        table.remove(self.Events, 1)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
    Utils.ok("📊 Hitbox Tracker: เริ่ม")
end

function HitboxTracker:getStats()
    local stats = {}
    for _, e in ipairs(self.Events) do
        if e.Duration then
            stats[e.Name] = stats[e.Name] or {
                count = 0, totalDur = 0,
                minDur = math.huge, maxDur = 0,
            }
            local s = stats[e.Name]
            s.count = s.count + 1
            s.totalDur = s.totalDur + e.Duration
            s.minDur = math.min(s.minDur, e.Duration)
            s.maxDur = math.max(s.maxDur, e.Duration)
        end
    end
    for _, s in pairs(stats) do
        s.avgDur = s.totalDur / s.count
    end
    return stats
end

