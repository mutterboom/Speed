-- ============================================
-- 2. ระบบวิ่งไว (เฉพาะตัวเรา)
-- ============================================
local function updateSpeed()
    -- ตรวจสอบให้แน่ใจว่า humanoid ยังเป็นของตัวเราเอง
    if not humanoid or not humanoid.Parent then return end
    if humanoid.Parent ~= character then return end

    if speedEnabled then
        local val = tonumber(speedBox.Text)
        if val and val > 0 then
            runSpeed = val
            humanoid.WalkSpeed = runSpeed
        else
            speedBox.Text = "50"
            runSpeed = 50
            humanoid.WalkSpeed = 50
        end
    else
        humanoid.WalkSpeed = 16 -- ค่าเริ่มต้นของ Roblox
    end
end

speedBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    if speedEnabled then
        speedBtn.Text = "วิ่งไว: เปิด"
        speedBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        speedBtn.Text = "วิ่งไว: ปิด"
        speedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    end
    updateSpeed()
end)

speedBox.FocusLost:Connect(function()
    updateSpeed()
end)

-- ============================================
-- 3. ระบบบินได้ (เฉพาะตัวเรา)
-- ============================================
local function startFly()
    -- ตรวจสอบว่า rootPart เป็นของตัวเราเอง
    if not rootPart or not rootPart.Parent then return end
    if rootPart.Parent ~= character then return end

    if bodyVelocity then bodyVelocity:Destroy() end
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    humanoid.PlatformStand = true
end

local function stopFly()
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    if humanoid and humanoid.Parent == character then
        humanoid.PlatformStand = false
        humanoid.WalkSpeed = speedEnabled and runSpeed or 16
    end
end

flyBtn.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    if flyEnabled then
        flyBtn.Text = "บินได้: เปิด"
        flyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        startFly()
    else
        flyBtn.Text = "บินได้: ปิด"
        flyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        stopFly()
    end
end)

flyBox.FocusLost:Connect(function()
    local val = tonumber(flyBox.Text)
    if val and val > 0 then
        flySpeed = val
    else
        flyBox.Text = "50"
        flySpeed = 50
    end
end)

-- ตรวจจับการกดปุ่ม
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysPressed[input.KeyCode] = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysPressed[input.KeyCode] = false
    end
end)

-- อัปเดตการบินทุกเฟรม
RunService.RenderStepped:Connect(function()
    -- ตรวจสอบว่าเป็นตัวละครของเราเองจริง
    if not flyEnabled or not bodyVelocity then return end
    if not rootPart or rootPart.Parent ~= character then return end

    local camera = workspace.CurrentCamera
    local moveDir = Vector3.new(0, 0, 0)

    if keysPressed[Enum.KeyCode.W] then
        moveDir = moveDir + camera.CFrame.LookVector
    end
    if keysPressed[Enum.KeyCode.S] then
        moveDir = moveDir - camera.CFrame.LookVector
    end
    if keysPressed[Enum.KeyCode.A] then
        moveDir = moveDir - camera.CFrame.RightVector
    end
    if keysPressed[Enum.KeyCode.D] then
        moveDir = moveDir + camera.CFrame.RightVector
    end
    if keysPressed[Enum.KeyCode.Space] then
        moveDir = moveDir + Vector3.new(0, 1, 0)
    end
    if keysPressed[Enum.KeyCode.LeftShift] then
        moveDir = moveDir - Vector3.new(0, 1, 0)
    end

    if moveDir.Magnitude > 0 then
        bodyVelocity.Velocity = moveDir.Unit * flySpeed
    else
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    end
end)

