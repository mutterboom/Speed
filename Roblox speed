-- 4. ปุ่มปิดเมนู
-- ============================================
closeBtn.MouseButton1Click:Connect(function()
    if flyEnabled then
        flyEnabled = false
        stopFly()
    end
    if speedEnabled then
        speedEnabled = false
        if humanoid and humanoid.Parent == character then
            humanoid.WalkSpeed = 16
        end
    end
    screenGui:Destroy()
end)

